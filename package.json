{
  "name": "capm_project",
  "version": "1.0.0",
  "description": "Welcome to your new project.",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "cds-serve",
    "watch-s4orders": "cds watch --open inv.anu.s4orders/index.html?sap-ui-xx-viewCache=false --livereload false",
    "undeploy": "cf undeploy CAPM_Project --delete-services --delete-service-keys --delete-service-brokers",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joshiharsh920/CAPM_Project.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/joshiharsh920/CAPM_Project/issues"
  },
  "homepage": "https://github.com/joshiharsh920/CAPM_Project#readme",
  "dependencies": {
    "@cap-js/hana": "^2",
    "@cap-js/sqlite": "^3.0.2",
    "@sap-cloud-sdk/http-client": "^4.8.0",
    "@sap-cloud-sdk/odata-v2": "^4.8.0",
    "@sap-cloud-sdk/resilience": "^4.8.0",
    "@sap/cds": "^10.0.4",
    "cors": "^2.8.6"
  },
  "cds": {
    "requires": {
      "ZTEST1_HARSH_DEMO_SRV": {
        "kind": "odata-v2",
        "model": "srv/external/ZTEST1_HARSH_DEMO_SRV.csn",
        "credentials": {
          "destination": "onPremService",
          "path": "/sap/opu/odata/sap/ZTEST1_HARSH_DEMO_SRV"
        }
      },
      "db": {
        "kind": "sqlite"
      },
      "auth": {
        "kind": "dummy"
      },
      "[production]": {
        "db": {
          "kind": "hana"
        }
      }
    }
  },
  "protocols": {
    "odata": {
      "cors": {
        "origin": "http://localhost:5173",
        "credentials": true,
        "methods": [
          "GET",
          "POST",
          "PUT",
          "PATCH",
          "DELETE",
          "OPTIONS"
        ],
        "allowedHeaders": [
          "Content-Type",
          "Authorization",
          "x-csrf-token"
        ]
      }
    }
  },
  "devDependencies": {
    "@sap-cloud-sdk/generator": "^4.8.0",
    "@sap/cds-dk": "^9.9.4",
    "cds-plugin-ui5": "^0.17.0",
    "rimraf": "^5.0.5",
    "mbt": "^1.2.49"
  },
  "workspaces": [
    "app/*"
  ]
}
