<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Dialog
        id="approvalDialog"
        title="Submit Purchase Order">

        <content>
            <VBox class="sapUiSmallMargin">
                <Label text="Remarks" />

                <TextArea
                    id="remarks"
                    width="100%"
                    placeholder="Enter remarks" />
            </VBox>
        </content>

        <beginButton>
            <Button
                text="Submit"
                type="Emphasized"
                press=".onSubmit" />
        </beginButton>

        <endButton>
            <Button
                text="Cancel"
                press=".onCancel" />
        </endButton>

    </Dialog>
</core:FragmentDefinition>